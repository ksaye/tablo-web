<?xml version="1.0" encoding="utf-8"?>
<!--
  TabloWeb Windows installer.

  Installs the self-contained win-x64 publish output into Program Files, registers TabloWeb as a
  Windows Service that starts automatically, and drops a Start Menu shortcut that opens the site
  in a browser.

  Build with the plain WiX CLI, not an MSBuild project — WixToolset.Sdk 5.0.2 turned out not to
  have a working directory-harvest MSBuild integration, and this repo already had a working
  pattern for that (see ~/ourtablo/installer/OurTablo.wxs on the win11 build VM, sshtest@
  192.168.15.189): `wix build` itself supports harvesting via the compiler-level <Files> element,
  no MSBuild SDK involved.

    dotnet publish ..\src\TabloWeb\TabloWeb.csproj -c Release -r win-x64 -p:SelfContained=true ^
        -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o publish
    wix extension add -g WixToolset.Firewall.wixext/5.0.2 WixToolset.Util.wixext/5.0.2
    wix build Product.wxs -arch x64 -ext WixToolset.Firewall.wixext -ext WixToolset.Util.wixext -d Version=1.1.0 -d PublishDir=publish -o TabloWeb-1.1.0.msi

  Everything under $(var.PublishDir) is harvested EXCEPT TabloWeb.exe, which gets its own
  Component below instead — it has to carry the ServiceInstall/ServiceControl pair, and a file can
  only belong to one component, so it cannot also come from the harvested group.

  UpgradeCode is permanent — generated once for this product and never to change. Every future
  release keeps it so a newer MSI upgrades the existing install (MajorUpgrade below) rather than
  sitting beside it as a second, conflicting product. See UpdateChecker.cs for the piece that
  downloads a future version of this MSI and launches it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="TabloWeb"
           Manufacturer="Kevin Saye"
           Version="$(var.Version)"
           UpgradeCode="bae3d4e2-abf9-4505-a9ad-9d4dabf495a7"
           Compressed="yes"
           Scope="perMachine">

    <SummaryInformation
      Description="TabloWeb — a browser front end for the Tablo 4th-generation DVR"
      Manufacturer="Kevin Saye" />

    <!--
      A major upgrade in place: installing a newer MSI over an older install removes the old
      files/service registration and puts the new ones down, rather than requiring an uninstall
      first. This is what makes the in-app "Update now" button (UpdateChecker.InstallAsync)
      usable — it just runs `msiexec /i <newer.msi> /qn`.
    -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of TabloWeb is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\TabloWeb.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ksaye/tablo-web" />

    <!--
      The ffmpeg the service downloads on first start (FfmpegSetup.cs) is not a file this package
      installed, so Windows Installer would leave it behind. Remember where the product lives, and
      remove that ffmpeg folder on a real uninstall - but not during an upgrade, or every new
      version would download it again.
    -->
    <Property Id="TABLOWEBFOLDER">
      <RegistrySearch Id="TabloWebFolderSearch" Root="HKLM" Key="Software\TabloWeb" Name="InstallFolder"
                      Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="FFMPEGFOLDER" Value="[TABLOWEBFOLDER]ffmpeg" After="AppSearch" Sequence="both"
                 Condition="TABLOWEBFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TabloWeb">
        <Directory Id="WwwRootFolder" Name="wwwroot" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="TabloWeb" />
    </StandardDirectory>

    <!-- <Files> has no Exclude attribute in this WiX version, so TabloWeb.exe (which needs its
         own Component below, paired with ServiceInstall) simply is not part of the harvested
         subtree: scoping the harvest to wwwroot\ keeps the two from ever colliding, rather than
         trying to subtract the exe back out of a whole-publish-dir harvest. -->
    <ComponentGroup Id="WwwRootFiles" Directory="WwwRootFolder">
      <Files Include="$(var.PublishDir)\wwwroot\**" />
    </ComponentGroup>

    <Component Id="TabloWebWebConfig" Directory="INSTALLFOLDER" Guid="*">
      <File Id="TabloWebWebConfig" Source="$(var.PublishDir)\web.config" KeyPath="yes" />
    </Component>

    <Component Id="TabloWebStaticAssetsManifest" Directory="INSTALLFOLDER" Guid="*">
      <File Id="TabloWebStaticAssetsManifest"
            Source="$(var.PublishDir)\TabloWeb.staticwebassets.endpoints.json" KeyPath="yes" />
    </Component>

    <Component Id="TabloWebService" Directory="INSTALLFOLDER" Guid="*">
      <File Id="TabloWebServiceExe" Source="$(var.PublishDir)\TabloWeb.exe" KeyPath="yes" />

      <!--
        LocalSystem, not a lesser account: the app needs to reach arbitrary LAN addresses (the
        Tablo itself, wherever it is), write its config/keys/credentials directory, and spawn
        ffmpeg. Start="auto" so a reboot brings it back without anyone visiting a console.
      -->
      <ServiceInstall Id="TabloWebServiceInstall"
                       Name="TabloWeb"
                       DisplayName="TabloWeb"
                       Description="Browser front end for the Tablo 4th-generation DVR. Serves http://localhost:8787."
                       Type="ownProcess"
                       Start="auto"
                       ErrorControl="normal"
                       Account="LocalSystem" />

      <!--
        Windows Firewall: a service gets no "allow access?" prompt, so without these rules nothing
        else on the network (a phone, a TV, the Fire TV app) could reach the site at all. Scoped to
        the local subnet on every profile - home networks are often classed "Public" - so the site
        is reachable from the house but not from beyond the router. UDP is network discovery
        (Discovery.cs). Removed again on uninstall.
      -->
      <RegistryValue Root="HKLM" Key="Software\TabloWeb" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
      <util:RemoveFolderEx On="uninstall" Property="FFMPEGFOLDER" Condition="NOT UPGRADINGPRODUCTCODE" />

      <fw:FirewallException Id="TabloWebHttp" Name="TabloWeb (web)" Protocol="tcp" Port="8787"
                            Scope="localSubnet" Profile="all" />
      <fw:FirewallException Id="TabloWebDiscovery" Name="TabloWeb (network discovery)" Protocol="udp" Port="8788"
                            Scope="localSubnet" Profile="all" />

      <!--
        Stop="both" covers install AND uninstall/upgrade — this is also what lets the in-app
        updater work unattended: msiexec stops the running service, replaces the files, and
        starts the new one back up, all inside one /qn install.
      -->
      <ServiceControl Id="TabloWebServiceControl"
                       Name="TabloWeb"
                       Start="install"
                       Stop="both"
                       Remove="uninstall"
                       Wait="yes" />
    </Component>

    <Component Id="TabloWebUrlFile" Directory="INSTALLFOLDER" Guid="*">
      <File Id="TabloWebUrlFile" Source="TabloWeb.url" KeyPath="yes" />
    </Component>

    <Component Id="OpenTabloWebShortcut" Directory="AppProgramMenuFolder" Guid="*">
      <Shortcut Id="OpenTabloWebMenuShortcut"
                Name="Open TabloWeb"
                Description="Open the TabloWeb guide in your browser"
                Target="[#TabloWebUrlFile]" />
      <RemoveFolder Id="RemoveAppProgramMenuFolder" Directory="AppProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\TabloWeb" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="TabloWeb" Level="1">
      <ComponentGroupRef Id="WwwRootFiles" />
      <ComponentRef Id="TabloWebWebConfig" />
      <ComponentRef Id="TabloWebStaticAssetsManifest" />
      <ComponentRef Id="TabloWebService" />
      <ComponentRef Id="TabloWebUrlFile" />
      <ComponentRef Id="OpenTabloWebShortcut" />
    </Feature>

  </Package>
</Wix>
